{
    "id": "mouthGuard",
    "name": "MouthGuard",
    "description": "Webcam mouth-closure tracker with alerts and session stats",
    "version": "0.1.0",
    "license": "MIT",
    "author": "sitolam",
    "icon": "sentiment_satisfied",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "control-center"],
    "components": {
        "daemon": "./MouthGuardDaemon.qml",
