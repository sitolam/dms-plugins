    "settings": "./MouthGuardSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "requires_dms": ">=1.5.0",
    "dependencies": ["python3", "python-opencv", "python-dlib"],
    "permissions": ["settings_read", "settings_write", "process"]
